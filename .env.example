# --- Authentication (Vertex AI preferred) ---
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GEMINI_API_KEY=
GEMINI_USE_VERTEX=true
VERTEX_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash

# --- Hosting ---
HIREFLOW_BASE_URL=https://hireflow-backend-296941301245.us-central1.run.app

# --- Pipeline caps ---
PIPELINE_MAX_JOBS=25
PIPELINE_MAX_SCORE=10
PIPELINE_MAX_PREP=5
PIPELINE_MAX_RESEARCH=8

# --- Resume parsing ---
RESUME_PARSE_MODE=hybrid

# --- Search intelligence ---
QUERY_EXPANSION=true
QUERY_EXPANSION_TERMS=6
JOB_RECENCY_DAYS=14
DIVERSITY_MAX_SAME_COMPANY=2
FREEHIRE_POSTED_WITHIN_DAYS=14
USE_UNVERIFIED_SOURCES=
FREEHIRE_SOURCES=seek,mycareersfuture

# --- Universal webfetch + discovery layer ---
WEB_SEARCH_ENDPOINT=https://lite.duckduckgo.com/lite/
WEB_FETCH=true
WEB_FETCH_TIMEOUT=12
WEB_DISCOVERY=true
WEB_DISCOVERY_MAX_LINKS=8
WEB_DISCOVERY_COMPANIES=

# --- Career-page sourcing ---
CAREER_SOURCE_ENABLED=true
CAREER_SOURCE_MAX_COMPANIES=5
CAREER_SOURCE_MAX_PER_COMPANY=8

# --- Semantic re-rank (embeddings) ---
SEMANTIC_SEARCH=
EMBEDDING_MODEL=gemini-embedding-001

# --- Layer II browser automation (Playwright) ---
HIREFLOW_PLAYWRIGHT=
PLAYWRIGHT_SPA_URLS=
JOBSTREET_ENABLED=true

# --- Sandbox ATS ---
SANDBOX_ATS_FILE=sandbox_ats.json