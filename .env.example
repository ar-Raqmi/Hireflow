# --- Authentication (Vertex AI preferred) ---
GCP_PROJECT_ID=hireflow-506207
# SECRET - path to the service-account JSON Zach provides. Unique per machine:
# replace /PATH/TO/... with your real path (e.g. ~/.gcp/hireflow-sa.json).
# Only needed for LOCAL runs - NOT used on Cloud Run.
GOOGLE_APPLICATION_CREDENTIALS=/PATH/TO/service-account.json
# SECRET - your Gemini API key (fallback only; Vertex is the live path).
# Different on every PC. Set it if you ever run without Vertex; leave blank
# on Cloud Run.
GEMINI_API_KEY=
GEMINI_USE_VERTEX=true
VERTEX_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash

# --- Hosting ---
HIREFLOW_BASE_URL=https://hireflow-backend-296941301245.us-central1.run.app

# --- Pipeline caps ---
PIPELINE_MAX_JOBS=60
PIPELINE_MAX_SCORE=60
PIPELINE_MAX_PREP=5
PIPELINE_MAX_RESEARCH=10
# Adaptive gather: search+score in batches until at least this many matches.
PIPELINE_MIN_MATCHES=10
PIPELINE_SCORE_BATCH=10
PIPELINE_MAX_SEARCH_SWEEPS=4

# --- Resume parsing ---
RESUME_PARSE_MODE=hybrid
# Classify uploads (reject non-resumes) + audit ATS health at upload time.
RESUME_AUDIT_ENABLED=true
# Below this ATS health score (or any error-severity finding) an upload is
# flagged "needs_improvement" and the user confirms before the pipeline runs.
RESUME_HEALTH_BLOCK=60

# --- Search intelligence ---
QUERY_EXPANSION=true
QUERY_EXPANSION_TERMS=6
JOB_RECENCY_DAYS=14
DIVERSITY_MAX_SAME_COMPANY=2
FREEHIRE_POSTED_WITHIN_DAYS=14
USE_UNVERIFIED_SOURCES=
FREEHIRE_SOURCES=seek,mycareersfuture

# --- Universal webfetch + discovery layer ---
WEB_FETCH=true
WEB_FETCH_TIMEOUT=12
WEB_DISCOVERY=true
WEB_DISCOVERY_MAX_LINKS=24

# --- Career-page sourcing ---
CAREER_SOURCE_ENABLED=true
CAREER_SOURCE_MAX_COMPANIES=5
CAREER_SOURCE_MAX_PER_COMPANY=8

# --- Semantic re-rank (embeddings) ---
SEMANTIC_SEARCH=
EMBEDDING_MODEL=gemini-embedding-001


# --- Sandbox ATS ---
SANDBOX_ATS_FILE=sandbox_ats.json

# --- deep search ---
# Blank = code default (all on): DEEP_SEARCH=true, WEB_DISCOVERY_MAX_CALLS=4,
# PIPELINE_MIN_STRONG=4, PIPELINE_MIN_COMPANIES=4
DEEP_SEARCH=true
WEB_DISCOVERY_MAX_CALLS=4
PIPELINE_MIN_STRONG=4
PIPELINE_MIN_COMPANIES=4
